NODE_ENV=development
FREE_MODE=false
PORT=3000
ADMIN_API_KEY=change-me
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instagram_ai
DATABASE_SSL=false
RUN_MIGRATIONS=true
APP_TIMEZONE=Asia/Kolkata
ENABLE_INTERNAL_SCHEDULER=true
PUBLIC_BASE_URL=https://your-public-domain.example

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest
ENABLE_AI_WEB_SEARCH=true
FREE_IMAGE_BASE_URL=https://placehold.co/1080x1080/111827/FFFFFF.jpg

INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
INSTAGRAM_GRAPH_VERSION=v24.0
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_EXPECTED_USERNAME=techinfo534

SOURCE_FEEDS=["https://openai.com/news/rss.xml"]
ALLOWED_SOURCE_HOSTS=openai.com,who.int,nasa.gov
MAX_DAILY_POSTS=3
MAX_UPLOAD_MB=8
DEFAULT_POST_IMAGE_URL=
